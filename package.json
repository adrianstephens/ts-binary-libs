{
	"name": "@isopodlabs/binary_libs",
	"description": "A package for reading various library file format with TypeScript.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adrianstephens/ts-binary-libs.git"
	},
	"exports": {
		".": "./dist/index.js",
		"./arch": "./dist/arch.js",
		"./clr": "./dist/clr.js",
		"./CompoundDocument": "./dist/CompoundDocument.js",
		"./elf": "./dist/elf.js",
		"./mach": "./dist/mach.js",
		"./pe": "./dist/pe.js",
		"./tar": "./dist/tar.js",
		"./zip": "./dist/zip.js"
	},
	"files": [
		"dist/**/*.{js,d.ts}",
		"README.md"
	],
	"scripts": {
		"prepare": "ts-patch install && copy-file node_modules/@isopodlabs/binary/scripts/transform.ts scripts/transform.ts",
		"build": "tsc",
		"watch": "tsc --watch -p ./",
		"lint": "eslint \"src/**/*.ts\"",
		"link": "npm link @isopodlabs/binary"
	},
	"keywords": [
		"binary",
		"typescript",
		"data",
		"read",
		"write"
	],
	"author": "Adrian Stephens",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.13.8",
		"@typescript-eslint/eslint-plugin": "^8.26.0",
		"@typescript-eslint/parser": "^8.26.0",
		"eslint": "^9.21.0",
		"ts-node": "^10.9.2",
		"ts-patch": "^3.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.26.0"
	},
	"version": "1.6.2",
	"dependencies": {
		"@isopodlabs/binary": "^1.9.0"
	}
}
