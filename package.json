{
	"name": "@isopodlabs/binary_libs",
	"description": "A package for reading various library file format with TypeScript.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adrianstephens/ts-binary-libs.git"
	},
	"exports": {
		".": "./dist/index.js",
		"./arch": "./dist/arch.js",
		"./clr": "./dist/clr.js",
		"./CompoundDocument": "./dist/CompoundDocument.js",
		"./elf": "./dist/elf.js",
		"./mach": "./dist/mach.js",
		"./pe": "./dist/pe.js",
		"./wasm": "./dist/wasm.js",
		"./ole": "./dist/ole.js"
	},
	"files": [
		"dist/**/*.{js,d.ts}",
		"README.md"
	],
	"scripts": {
		"build": "TS_NODE_COMPILER_OPTIONS='{\"ignoreDeprecations\":\"6.0\"}' tsc -b .",
		"watch": "TS_NODE_COMPILER_OPTIONS='{\"ignoreDeprecations\":\"6.0\"}' tsc --watch -p ./",
		"lint": "eslint \"src/**/*.ts\"",
		"link": "npm link @isopodlabs/binary",
		"update": "npm install @isopodlabs/binary@latest"
	},
	"keywords": [
		"binary",
		"typescript",
		"data",
		"read",
		"write"
	],
	"author": "Adrian Stephens",
	"license": "MIT",
	"version": "1.10.0",
	"dependencies": {
		"@isopodlabs/binary": "^2.0.1"
	}
}
